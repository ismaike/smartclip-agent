{
  "name": "smartclip-mcp",
  "type": "module",
  "version": "0.8.1",
  "description": "MCP Server for SmartClip Chrome Extension - enables AI agents to clip web pages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ismaike/smartclip-agent",
    "directory": "smartclip-agent/packages/smartclip-mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chrome-extension",
    "web-clipper",
    "smartclip",
    "notion",
    "obsidian"
  ],
  "main": "dist/index.js",
  "bin": {
    "smartclip-mcp": "dist/index.js"
  },
  "files": [
    "README.md",
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "smartclip-bridge-protocol": "workspace:*",
    "ws": "^8.19.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
