{
  "name": "smartclip-mcp",
  "type": "module",
  "version": "1.7.0",
  "mcpName": "app.smartclip/smartclip-mcp",
  "description": "Chrome Extension-powered MCP server that lets AI agents (Claude Code, Cursor, Gemini CLI, Windsurf) read logged-in webpages as Markdown and clip them to 16 note-taking apps.",
  "homepage": "https://smartclip.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ismaike/smartclip-agent",
    "directory": "packages/smartclip-mcp"
  },
  "bugs": {
    "url": "https://github.com/ismaike/smartclip-agent/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "windsurf",
    "gemini-cli",
    "opencode",
    "ai-agent",
    "chrome-extension",
    "web-clipper",
    "html-to-markdown",
    "read-logged-in-pages",
    "browser-bridge",
    "smartclip",
    "obsidian",
    "notion",
    "flomo",
    "siyuan",
    "logseq",
    "joplin",
    "feishu",
    "yuque",
    "memos",
    "wolai",
    "flowus"
  ],
  "main": "dist/index.js",
  "bin": {
    "smartclip-mcp": "dist/index.js"
  },
  "files": [
    "README.md",
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "smartclip-bridge-protocol": "workspace:*",
    "ws": "^8.19.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
